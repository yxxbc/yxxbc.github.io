{{- $items := slice }}
{{- range where site.RegularPages "Section" "post" }}
{{- $items = $items | append (dict
  "title" .Title
  "url" .RelPermalink
  "date" (.Date.Format "2006.01.02")
  "description" .Description
  "categories" (.Params.categories | default slice)
  "content" (.Plain | truncate 4000 "")
) }}
{{- end }}
{{- $items | jsonify }}
